
#include <iostream>
using namespace std;

/* Write a program to print Ceil of Numbers, don't use built
   in Ceil function */

float ReadNumber()
{
	float Number;
	cout << "Plz Enter a float Number : ";
	cin >> Number;
	return Number;
}

float GetFractionPart(float Number)
{
	return Number - int(Number);
}

int MyCeil(float Number)
{
	if (abs(GetFractionPart(Number)) > 0)
	{
		if (Number > 0)
			return int(Number) + 1;
		else
			return int(Number);
	}
	else
		return Number;
}

int main()
{
	float Number = ReadNumber();

	cout << "\nMy Ceil Result : " << MyCeil(Number) << endl;
	cout << "\nC++ Ceil Result : " << ceil(Number) << endl;
}










