
#include <iostream>
using namespace std;

//Write a Program To Read a Number and Print it Reversed.

int ReadPositiveNumber(string Message)
{
	int Number = 0;
	do
	{
		cout << Message;
		cin >> Number;

	} while (Number <= 0);
	return Number;
}

int ReverseNumber(int Number)
{
	int Remainder = 0, Number2 = 0;

	while (Number > 0)
	{
		Remainder = Number % 10;  
		Number = Number / 10;    
		Number2 = Number2 * 10 + Remainder;  
	}
	return Number2;
}

int main()
{
	cout << "\nRevers Number is : "
		<< ReverseNumber(ReadPositiveNumber("Plz Enter a Positive Number : "));
	cout << "\n";
}
