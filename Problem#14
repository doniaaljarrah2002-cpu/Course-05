
#include <iostream>
using namespace std;

/* Write a program to read a number and print inverted letter pattern
 as follows : 3
 CCC
 BB
 A
*/

int ReadPositiveNumber(string Message)
{
	int Number = 0;
	do
	{
		cout << Message;
		cin >> Number;

	} while (Number <= 0);

	return Number;
}

void PrintInvertedLetterPattern(int Number)
{
	cout << "\n";
	for (int i = Number; i >= 1; i--)
	{
		for (int j = 1; j <= i; j++)
		{
			cout << char(65 + i - 1);
		}
		cout << "\n";
	}
}

int main()
{
	PrintInvertedLetterPattern(ReadPositiveNumber("Plz Enter a Positive Number : "));
}

































