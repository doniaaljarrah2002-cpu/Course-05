
#include <iostream>
using namespace std;

//Write a Program To Read a Number and Print the Sum Of its digits 

int ReadPositiveNumber(string Message)
{
	int Number = 0;
	do
	{
		cout << Message;
		cin >> Number;

	} while (Number <= 0);
	return Number;
}

int SumOfDigits(int Number)
{
	int Remainder = 0, Sum = 0;

	while (Number > 0)
	{
		Remainder = Number % 10;
		Number = Number / 10;
		Sum += Remainder;
	}
	return Sum;
}

int main()
{
	cout << "\nSum Of Digits = " <<
		SumOfDigits(ReadPositiveNumber("Plz Enter a Positive Number : ")) << endl;
}










