
#include <iostream>
using namespace std;

/* Write a program to read a number and print inverted pattern 
 as follows : 3
 333
 22
 1
*/

int ReadPositiveNumber(string Message)
{
	int Number = 0;
	do
	{
		cout << Message;
		cin >> Number;

	} while (Number <= 0);

	return Number;
}

void PrintInvertedNumberPattern(int Number)
{
	cout << endl;
	for (int i = Number; i >= 1; i--)
	{
		for (int j = 1; j <= i; j++)
		{
			cout << i;
		}
		cout << "\n";
	}
}

int main()
{
	PrintInvertedNumberPattern(ReadPositiveNumber("Plz Enter a Positive Number : "));
}


































