
#include <iostream>
#include <string>
#include <cstdlib>
using namespace std;

/* Write a program to print random Small Letter,Capital Letter ,
  Spical Character, and Digit in order */

enum enCharType {
	SmallLetter = 1, CapitalLetter = 2,
	SpicalCharacter = 3, Digit = 4
};

int RandomNumber(int From, int To)
{
	int RandNum = rand() % (To - From + 1) + From;
	return RandNum;
}

char GetRandaomCharacter(enCharType CharType)
{
	switch (CharType)
	{
	case enCharType::SmallLetter:
	{
		return char(RandomNumber(97, 122));
		break;
	}
	case enCharType::CapitalLetter:
	{
		return char(RandomNumber(65, 90));
		break;
	}
	case enCharType::SpicalCharacter:
	{
		return char(RandomNumber(33, 47));
		break;
	}
	case enCharType::Digit:
	{
		return char(RandomNumber(48, 57));
		break;
	}
	}
}

int main()
{
	srand((unsigned)time(NULL));

	cout << GetRandaomCharacter(enCharType::SmallLetter) << endl;
	cout << GetRandaomCharacter(enCharType::CapitalLetter) << endl;
	cout << GetRandaomCharacter(enCharType::SpicalCharacter) << endl;
	cout << GetRandaomCharacter(enCharType::Digit) << endl;
}


















