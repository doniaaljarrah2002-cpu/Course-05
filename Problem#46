
#include <iostream>
using namespace std;

/* Write a program to print abs of Numbers, don't use built
   in abs function */

float MyABS(float Number)
{
	if (Number > 0)
		return Number;
	else
		return Number * -1;
}

float ReadNumber()
{
	float Number;
	cout << "Plz Enter a Number : ";
	cin >> Number;
	return Number;
}

int main()
{
	float Number = ReadNumber();

	cout << "\nMy ABS Result : " << MyABS(Number) << endl;
	cout << "\nC++ ABS Result : " << abs(Number) << endl;
}


