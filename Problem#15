
#include <iostream>
using namespace std;

/* Write a program to read a number and print letter pattern
 as follows : 3
 A
 BB
 CCC
*/

int ReadPositiveNumber(string Message)
{
	int Number = 0;
	do
	{
		cout << Message;
		cin >> Number;

	} while (Number <= 0);

	return Number;
}

void PrintLetterPattern(int Number)
{
	cout << "\n";
	for (int i = 1; i <= Number; i++)
	{
		for (int j = 1; j <= i; j++)
		{
			cout << char(65 + i - 1);
		}
		cout << "\n";
	}
}

int main()
{
	PrintLetterPattern(ReadPositiveNumber("Plz Enter a Positive Number : "));
}
























